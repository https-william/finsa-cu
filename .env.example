# FINSA Online · Environment Configuration Template
# Copy this file to .env.local when connecting live credentials

# 1. Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Paystack Payment Gateway (Course Dues Collection)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# 3. Portal Base URL
NEXT_PUBLIC_APP_URL=https://finsa-covenant.vercel.app
